# Copy to .env for local use, or set server environment variables / Streamlit secrets.
# Core prototype requires no keys.
OPENALEX_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Allow rate-limited research/funding refresh in an anonymous hosted demo:
NEXUS_ALLOW_PUBLIC_REFRESH=1
NEXUS_EMBEDDINGS=tfidf
NEXUS_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Additional reviewed public website hosts, comma separated:
NEXUS_SOURCE_HOSTS=
# Optional absolute path to a separate SQLite database
NEXUS_DB=

